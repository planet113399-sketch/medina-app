{
  "lesson_id": 6,
  "title": "الدرس السَّادِسُ - هَذِهِ (Женский род)",
  "rules_table": [
    {
      "rule": "Указательное местоимение هَذِهِ (хазихи)",
      "description": "Указывает на близкий объект женского рода ('Это... / Эта...').",
      "example": "هَذِهِ بِنْتٌ (Это девочка)"
    },
    {
      "rule": "Признак женского рода: Та-марбута (ة)",
      "description": "Большинство существительных и прилагательных ж.р. оканчиваются на 'ة'.",
      "example": "سَاعَةٌ, سَيَّارَةٌ, مَلْعَقَةٌ"
    },
    {
      "rule": "Парные органы тела (Женский род)",
      "description": "Парные части тела (глаз, ухо, рука, нога) относятся к женскому роду без 'ة'!",
      "example": "هَذِهِ عَيْنٌ (Это глаз), هَذِهِ يَدٌ (Это рука)"
    },
    {
      "rule": "Предлог لِـ (ли)",
      "description": "Указывает на принадлежность ('для / принадлежит...').",
      "example": "هَذَا لِلَّهِ (Это принадлежит Аллаху)"
    }
  ],
  "vocabulary": [
    {"arabic": "بِنْتٌ", "ru": "дочь / девочка"},
    {"arabic": "أُخْتٌ", "ru": "сестра"},
    {"arabic": "سَاعَةٌ", "ru": "часы"},
    {"arabic": "سَيَّارَةٌ", "ru": "машина"},
    {"arabic": "مَلْعَقَةٌ", "ru": "ложка"},
    {"arabic": "قِدْرٌ", "ru": "кастрюля"},
    {"arabic": "مَكْواةٌ", "ru": "утюг"},
    {"arabic": "دَرَّاجَةٌ", "ru": "велосипед"},
    {"arabic": "مُهَنْدِسٌ", "ru": "инженер"},
    {"arabic": "فَلاَّحٌ", "ru": "фермер / крестьянин"},
    {"arabic": "أَنْفٌ", "ru": "нос (м.р.)"},
    {"arabic": "فَمٌ", "ru": "рот (м.р.)"},
    {"arabic": "أُذُنٌ", "ru": "ухо (ж.р.)"},
    {"arabic": "عَيْنٌ", "ru": "глаз (ж.р.)"},
    {"arabic": "يَدٌ", "ru": "рука (ж.р.)"},
    {"arabic": "رِجْلٌ", "ru": "нога (ж.р.)"}
  ],
  "sections": [
    {
      "title": "Часть 1: Мужской и женский род",
      "items": [
        {"arabic": "هَذَا ابْنُ حَامِدٍ وَهَذِهِ بِنْتُ يَاسِرٍ", "ru": "Это сын Хамида, а это дочь Ясира"},
        {"arabic": "ابْنُ حَامِدٍ جَالِسٌ وَبِنْتُ يَاسِرٍ وَاقِفَةٌ", "ru": "Сын Хамида сидит, а дочь Ясира стоит"},
        {"arabic": "مَنْ هَذِهِ؟ هَذِهِ أُخْتُ الْمُهَنْدِسِ", "ru": "Кто это? Это сестра инженера"},
        {"arabic": "أَهِيَ أَيْضًا مُهَنْدِسَةٌ؟ لَا، هِيَ طَبِيبَةٌ", "ru": "Она тоже инженер? Нет, она врач"},
        {"arabic": "هَذِهِ سَيَّارَةُ الْمُدِيرِ وَهَذِهِ مَكْواةٌ", "ru": "Это машина директора, а это утюг"},
        {"arabic": "لِمَنْ هَذِهِ؟ هَذِهِ لِخَالِدٍ", "ru": "Чье это? Это принадлежит Халиду"},
        {"arabic": "أَدَرَّاجَةُ أَنَسٍ هَذِهِ؟ لَا، هَذِهِ دَرَّاجَةُ عَمَّارٍ", "ru": "Это велосипед Анаса? Нет, это велосипед Аммара"}
      ]
    },
    {
      "title": "Часть 2: Части тела",
      "items": [
        {"arabic": "هَذَا أَنْفٌ وَهَذَا فَمٌ", "ru": "Это нос, а это рот"},
        {"arabic": "هَذِهِ أُذُنٌ وَهَذِهِ عَيْنٌ", "ru": "Это ухо, а это глаз"},
        {"arabic": "هَذِهِ يَدٌ وَهَذِهِ رِجْلٌ", "ru": "Это рука, а это нога"},
        {"arabic": "هَذِهِ مَلْعَقَةٌ وَهَذِهِ قِدْرٌ، الْمَلْعَقَةُ فِي الْقِدْرِ", "ru": "Это ложка, а это кастрюля. Ложка в кастрюле"}
      ]
    }
  ]
}