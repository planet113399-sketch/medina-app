  "title": "الدرس الثَّالِثُ - الأَلِفُ وَاللاَّمُ (الـ)",
  "rules_table": [
    {
      "rule": "Определённый артикль (الـ)",
      "description": "Делает слово определённым (معرفة). При добавлении 'الـ' танвин на конце слова исчезает!",
      "example": "بَيْتٌ ➔ الْبَيْتُ"
    },
    {
      "rule": "Солнечные и лунные буквы",
      "description": "Перед солнечными буквами 'ل' в артикле не читается, а следующая буква удваивается.",
      "example": "الشَّمْسُ (аш-шамсу), الْقَمَرُ (аль-камару)"
    }
  ],
