{
  "lesson_id": 4,
  "title": "الدرس الرَّابِعُ - حُرُوفُ الْجَرِّ (فِي / عَلَى / مِنْ / إِلَى)",
  "rules_table": [
    {
      "rule": "Предлоги места (حُرُوفُ الْجَرِّ)",
      "description": "Предлоги فِي (в), عَلَى (на), مِنْ (из/от), إِلَى (к/в).",
      "example": "فِي الْبَيْتِ, عَلَى الْمَكْتَبِ"
    },
    {
      "rule": "Падеж маджрур (الْمَجْرُورُ)",
      "description": "После предлога имя получает огласовку Кясра (ـِ / ـٍ) на конце.",
      "example": "الْمَسْجِدُ ➔ فِي الْمَسْجِدِ"
    },
    {
      "rule": "Раздельные местоимения هُوَ / هِيَ",
      "description": "هُوَ (он) — для м.р., هِيَ (она) — для ж.р. (в т.ч. неодушевленных).",
      "example": "أَيْنَ مُحَمَّدٌ؟ هُوَ فِي الْغُرْفَةِ"
    }
  ],
  "vocabulary": [
    {"arabic": "الْغُرْفَةُ", "ru": "комната"},
    {"arabic": "الْحَمَّامُ", "ru": "ванная / туалет"},
    {"arabic": "الْمَطْبَخُ", "ru": "кухня"},
    {"arabic": "الْمَدْرَسَةُ", "ru": "школа"},
    {"arabic": "الْجَامِعَةُ", "ru": "университет"},
    {"arabic": "الفَصْلُ", "ru": "класс / аудитория"},
    {"arabic": "السُّوقُ", "ru": "рынок"},
    {"arabic": "الْيَابَانُ", "ru": "Япония"},
    {"arabic": "الصِّينُ", "ru": "Китай"},
    {"arabic": "الْهِنْدُ", "ru": "Индия"},
    {"arabic": "الْفِلِبِّينُ", "ru": "Филиппины"},
    {"arabic": "الْمُدِيرُ", "ru": "директор"}
  ],
  "sections": [
    {
      "title": "Часть 1: Предлоги فِي и عَلَى",
      "items": [
        {"arabic": "أَيْنَ مُحَمَّدٌ؟ هُوَ فِي الْغُرْفَةِ", "ru": "Где Мухаммад? Он в комнате"},
        {"arabic": "وَأَيْنَ يَاسِرٌ؟ هُوَ فِي الْحَمَّامِ", "ru": "А где Ясир? Он в ванной"},
        {"arabic": "وَأَيْنَ آمِنَةُ؟ هِيَ فِي الْمَطْبَخِ", "ru": "А где Амина? Она на кухне"},
        {"arabic": "أَيْنَ السَّاعَةُ؟ هِيَ عَلَى الْمَكْتَبِ", "ru": "Где часы? Они на столе"},
        {"arabic": "أَيْنَ الْكِتَابُ؟ هُوَ عَلَى السَّرِيرِ", "ru": "Где книга? Она на кровати"}
      ]
    },
    {
      "title": "Часть 2: Предлоги مِنْ и إِلَى",
      "items": [
        {"arabic": "مِنْ أَيْنَ أَنْتَ؟ أَنَا مِنَ الْيَابَانِ", "ru": "Откуда ты? Я из Японии"},
        {"arabic": "وَمِنْ أَيْنَ عَمَّارٌ؟ هُوَ مِنَ الصِّينِ", "ru": "А откуда Аммар? Он из Китая"},
        {"arabic": "وَمِنْ أَيْنَ حَامِدٌ؟ هُوَ مِنَ الْهِنْدِ", "ru": "А откуда Хамид? Он из Индии"},
        {"arabic": "خَرَجَ الْمُدَرِّسُ مِنَ الفَصْلِ", "ru": "Учитель вышел из класса"},
        {"arabic": "وَذَهَبَ إِلَى الْمُدِيرِ", "ru": "И пошел к директору"},
        {"arabic": "ذَهَبَ التَّاجِرُ إِلَى السُّوقِ", "ru": "Торговец пошел на рынок"}
      ]
    }
  ]
}