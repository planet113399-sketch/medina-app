{
  "lesson_id": 2,
  "title": "الدرس الثَّانِي - ذَلِكَ / وَ",
  "rules_table": [
    {
      "rule": "Указательное местоимение ذَلِكَ (залика)",
      "description": "Указывает на далёкий объект мужского рода ('То... / Тот...').",
      "example": "ذَلِكَ نَجْمٌ (То — звезда)"
    },
    {
      "rule": "Соединительный союз وَ (ва)",
      "description": "Соединяет слова и предложения в значении 'и'.",
      "example": "هَذَا بَيْتٌ وَذَلِكَ مَسْجِدٌ (Это — дом, а то — мечеть)"
    }
  ],
  "vocabulary": [
    {"arabic": "إِمَامٌ", "ru": "имам (молитвенный лидер)"},
    {"arabic": "حَجَرٌ", "ru": "камень"},
    {"arabic": "سُكَّرٌ", "ru": "сахар"},
    {"arabic": "لَبَنٌ", "ru": "молоко / кефир"},
    {"arabic": "قِطٌّ", "ru": "кот"},
    {"arabic": "نَجْمٌ", "ru": "звезда"}
  ],
  "sections": [
    {
      "title": "Практические фразы",
      "items": [
        {"arabic": "مَا ذَلِكَ؟ ذَلِكَ نَجْمٌ", "ru": "Что то? То — звезда"},
        {"arabic": "هَذَا مَسْجِدٌ وَذَلِكَ بَيْتٌ", "ru": "Это — мечеть, а то — дом"},
        {"arabic": "هَذَا حِصَانٌ وَذَلِكَ حِمَارٌ", "ru": "Это — конь, а то — осел"},
        {"arabic": "أَذَلِكَ كَلْبٌ؟ لَا، ذَلِكَ قِطٌّ", "ru": "То собака? Нет, то — кот"},
        {"arabic": "مَا ذَلِكَ؟ ذَلِكَ سَرِيرٌ", "ru": "Что то? То — кровать"},
        {"arabic": "مَنْ هَذَا وَمَنْ ذَلِكَ؟", "ru": "Кто это и кто то?"},
        {"arabic": "هَذَا مُدَرِّسٌ وَذَلِكَ إِمَامٌ", "ru": "Это — учитель, а то — имам"},
        {"arabic": "مَا ذَلِكَ؟ ذَلِكَ حَجَرٌ", "ru": "Что то? То — камень"},
        {"arabic": "هَذَا سُكَّرٌ وَذَلِكَ لَبَنٌ", "ru": "Это — сахар, а то — молоко"}
      ]
    }
  ]
}