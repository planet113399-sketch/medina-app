  "sections": [
    {
      "title": "Часть 1: Указание на предметы и простые вопросы",
      "items": [
        {"arabic": "هَذَا بَيْتٌ", "ru": "Это дом"},
        {"arabic": "هَذَا مَسْجِدٌ", "ru": "Это мечеть"},
        {"arabic": "هَذَا بَابٌ", "ru": "Это дверь"},
        {"arabic": "هَذَا كِتَابٌ", "ru": "Это книга"},
        {"arabic": "هَذَا قَلَمٌ", "ru": "Это ручка"},
        {"arabic": "هَذَا مِفْتَاحٌ", "ru": "Это ключ"},
        {"arabic": "هَذَا مَكْتَبٌ", "ru": "Это письменный стол"},
        {"arabic": "هَذَا سَرِيرٌ", "ru": "Это кровать"},
        {"arabic": "هَذَا كُرْسِيٌّ", "ru": "Это стул"},
        {"arabic": "مَا هَذَا؟ هَذَا بَيْتٌ", "ru": "Что это? Это дом"},
        {"arabic": "أَهَذَا بَيْتٌ؟ نَعَمْ، هَذَا بَيْتٌ", "ru": "Это дом? Да, это дом"},
        {"arabic": "أَهَذَا قَمِيصٌ؟ نَعَمْ، هَذَا قَمِيصٌ", "ru": "Это рубашка? Да, это рубашка"},
        {"arabic": "أَهَذَا سَرِيرٌ؟ لَا، هَذَا كُرْسِيٌّ", "ru": "Это кровать? Нет, это стул"},
        {"arabic": "أَهَذَا مِفْتَاحٌ؟ لَا، هَذَا قَلَمٌ", "ru": "Это ключ? Нет, это ручка"},
        {"arabic": "مَا هَذَا؟ هَذَا نَجْمٌ", "ru": "Что это? Это звезда"}
      ]
    },
    {
      "title": "Часть 2: Вопросы к одушевлённым объектам (مَنْ هَذَا؟)",
      "items": [
        {"arabic": "مَنْ هَذَا؟ هَذَا طَبِيبٌ", "ru": "Кто это? Это врач"},
        {"arabic": "مَنْ هَذَا؟ هَذَا وَلَدٌ", "ru": "Кто это? Это мальчик"},
        {"arabic": "مَنْ هَذَا؟ هَذَا طَالِبٌ", "ru": "Кто это? Это студент"},
        {"arabic": "أَهَذَا وَلَدٌ؟ لَا، هَذَا رَجُلٌ", "ru": "Это мальчик? Нет, это мужчина"},
        {"arabic": "مَا هَذَا؟ هَذَا مَسْجِدٌ", "ru": "Что это? Это мечеть"},
        {"arabic": "مَنْ هَذَا؟ هَذَا تَاجِرٌ", "ru": "Кто это? Это торговец"},
        {"arabic": "هَذَا كَلْبٌ. أَهَذَا كَلْبٌ؟ لَا، هَذَا قِطٌّ", "ru": "Это собака. Это собака? Нет, это кот"},
        {"arabic": "هَذَا حِمَارٌ. أَهَذَا حِمَارٌ؟ لَا، هَذَا حِصَانٌ", "ru": "Это осел. Это осел? Нет, это конь"},
        {"arabic": "وَمَا هَذَا؟ هَذَا جَمَلٌ", "ru": "А что это? Это верблюд"},
        {"arabic": "مَنْ هَذَا؟ هَذَا مُدَرِّسٌ", "ru": "Кто это? Это учитель"},
        {"arabic": "أَهَذَا قَمِيصٌ؟ لَا، هَذَا مِنْدِيلٌ", "ru": "Это рубашка? Нет, это платок"}
      ]
    }
  ]
