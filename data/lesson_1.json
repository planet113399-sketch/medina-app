{
  "lesson_id": 1,
  "title": "الدرس الأَوَّلُ - هَذَا / مَا / مَنْ / أَمْ",
  "rules_table": [
    {
      "rule": "Указательное местоимение هَذَا (хаза)",
      "description": "Указывает на близкий объект мужского рода ('Это...').",
      "example": "هَذَا بَيْتٌ (Это дом)"
    },
    {
      "rule": "Вопросительное местоимение مَا (ма)",
      "description": "Используется для вопроса к неодушевлённым предметам ('Что это?').",
      "example": "مَا هَذَا؟ (Что это?)"
    },
    {
      "rule": "Вопросительное местоимение مَنْ (ман)",
      "description": "Используется для вопроса к одушевлённым объектам ('Кто это?').",
      "example": "مَنْ هَذَا؟ (Кто это?)"
    },
    {
      "rule": "Вопросительная частица أَ (а)",
      "description": "Ставится в начале предложения для общего вопроса ('Ли...?').",
      "example": "أَهَذَا بَيْتٌ؟ (Это дом?)"
    }
  ],
