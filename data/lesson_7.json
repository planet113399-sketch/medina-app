{
  "lesson_id": 7,
  "title": "الدرس السَّابِعُ - تِلْكَ (Далекий объект Ж.Р.)",
  "rules_table": [
    {
      "rule": "Указательное местоимение تِلْكَ (тилька)",
      "description": "Указывает на далёкий объект женского рода ('То... / Та...'). Пара к ذَلِكَ.",
      "example": "تِلْكَ نَاقَةٌ (То — верблюдица)"
    },
    {
      "rule": "Сравнение: هَذِهِ vs تِلْكَ",
      "description": "هَذِهِ — близко (ж.р.), تِلْكَ — далеко (ж.р.).",
      "example": "هَذِهِ بَضَّةٌ وَتِلْكَ دَجَاجَةٌ"
    }
  ],
  "vocabulary": [
    {"arabic": "دَجَاجَةٌ", "ru": "курица"},
    {"arabic": "بَطَّةٌ", "ru": "утка"},
    {"arabic": "مُمَرِّضَةٌ", "ru": "медсестра"},
    {"arabic": "مُؤَذِّنٌ", "ru": "муэдзин"},
    {"arabic": "نَاقَةٌ", "ru": "верблюдица"},
    {"arabic": "بَيْضَةٌ", "ru": "яйцо"},
    {"arabic": "الْحَدِيقَةُ", "ru": "сад / парк"}
  ],
  "sections": [
    {
      "title": "Практические фразы",
      "items": [
        {"arabic": "مَنْ هَذِهِ وَمَنْ تِلْكَ؟", "ru": "Кто это и кто то?"},
        {"arabic": "هَذِهِ طَبِيبَةٌ وَتِلْكَ مُمَرِّضَةٌ", "ru": "Это — врач (женщина), а то — медсестра"},
        {"arabic": "هَذِهِ مِنَ الْهِنْدِ وَتِلْكَ مِنَ الْيَابَانِ", "ru": "Эта из Индии, а та из Японии"},
        {"arabic": "هَذِهِ طَوِيلَةٌ وَتِلْكَ قَصِيرَةٌ", "ru": "Эта высокая, а та короткая (низкая)"},
        {"arabic": "مَا تِلْكَ؟ تِلْكَ بَيْضَةٌ", "ru": "Что то? То — яйцо"},
        {"arabic": "هَذِهِ سَيَّارَةُ الْمُدَرِّسِ وَتِلْكَ سَيَّارَةُ الْمُدِيرِ", "ru": "Это машина учителя, а то машина директора"},
        {"arabic": "أَتِلْكَ دَجَاجَةٌ؟ لَا، تِلْكَ بَطَّةٌ", "ru": "То курица? Нет, то — утка"},
        {"arabic": "هَذَا مَسْجِدٌ وَتِلْكَ مَدْرَسَةٌ", "ru": "Это — мечеть, а то — школа"}
      ]
    }
  ]
}